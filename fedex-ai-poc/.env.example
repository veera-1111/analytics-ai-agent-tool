# ── AI Provider ──────────────────────────────────────────────
# Options: mock | bedrock
AI_PROVIDER=mock

# ── AWS Bedrock (only when AI_PROVIDER=bedrock) ─────────────
AWS_REGION=us-east-1
AWS_PROFILE=anuruhu-dev
BEDROCK_MODEL_ID=us.meta.llama3-1-70b-instruct-v1:0

# ── Database ─────────────────────────────────────────────────
DB_PATH=/data/analytics.db

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS / Embedding ────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
FRAME_ANCESTORS=http://localhost:8081

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8000
LOG_LEVEL=info

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=/api
